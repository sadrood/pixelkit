{
  "name": "pixelkit",
  "version": "1.0.0",
  "description": "PixelKit - 在线图片工具箱，支持图片拼接与格式转换",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "postinstall": "node -e \"var f=require('fs');var d='public/wasm';f.mkdirSync(d,{recursive:true});var s='node_modules/onnxruntime-web/dist/';var files=['ort-wasm-simd-threaded.wasm','ort-wasm-simd-threaded.jsep.wasm','ort-wasm-simd-threaded.jspi.wasm','ort-wasm-simd-threaded.asyncify.wasm','ort-wasm-simd-threaded.mjs','ort-wasm-simd-threaded.jsep.mjs','ort-wasm-simd-threaded.jspi.mjs','ort-wasm-simd-threaded.asyncify.mjs'];files.forEach(function(n){f.cpSync(s+n,d+'/'+n)})\""
  },
  "dependencies": {
    "@eigenpal/docx-editor-react": "^1.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "flag-icons": "^7.6.0",
    "hls.js": "^1.7.3",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "onnxruntime-web": "^1.27.0",
    "pdfjs-dist": "^6.0.227",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.1",
    "three": "^0.165.0",
    "undici": "^8.12.3",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.3",
    "vite": "^5.4.0"
  }
}
